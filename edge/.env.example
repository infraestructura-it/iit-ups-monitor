# Copia este archivo como .env (en la Raspberry: /opt/iit-ups-monitor/edge/.env)
# Todo lo que definas aquí sobrescribe config/default.json

DEVICE_ID=ups-01
DEVICE_NAME=UPS principal
DEVICE_SITE=Sede principal

# megatec | nut | simulator
UPS_DRIVER=megatec
UPS_PORT=/dev/ups-serial
UPS_BAUD=2400
POLL_MS=2000

# Si usas NUT (UPS USB HID: APC, Eaton, CyberPower, Tripp Lite, Megatec USB 0665:5161...)
NUT_UPS=ups
NUT_USER=monitor
NUT_PASSWORD=

# Datos de placa de la UPS (mejoran los cálculos estimados de potencia y batería)
UPS_RATED_VA=
UPS_POWER_FACTOR=0.8
UPS_BATTERY_CELLS=

HTTP_PORT=8080
# Clave para ejecutar comandos (prueba de batería, beeper). Vacía = comandos deshabilitados
API_COMMAND_KEY=

# Capa nube (Supabase)
CLOUD_ENABLED=false
SUPABASE_URL=https://jntxowiyfwhthxhuoifb.supabase.co
SUPABASE_SERVICE_KEY=
