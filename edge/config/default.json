    "relayActiveLow": true,
    "senseActiveLow": true,
    "sensePull": "up",
    "tickMs": 100,
    "confirmMs": 500,
    "deadTimeMs": 300,
    "returnDelaySec": 60,
    "autoReturn": true,
    "maxTransfers": 3,
    "windowMin": 10,
    "useUpsData": true,
    "outputMinV": 90,
    "gridMinV": 90
