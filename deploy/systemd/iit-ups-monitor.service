[Unit]
Description=IIT UPS Monitor (capa local Raspberry Pi)
After=network-online.target nut-server.service
Wants=network-online.target

[Service]
Type=simple
User=iitups
Group=iitups
SupplementaryGroups=dialout nut
WorkingDirectory=/opt/iit-ups-monitor/edge
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Protecciones
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/iit-ups-monitor/edge/data

[Install]
WantedBy=multi-user.target
